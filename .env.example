# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_ID=123456789,987654321

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://tca:tca_secret@postgres:5432/telegram_cursor_agent

# Redis
REDIS_URL=redis://redis:6379/0

# Cursor CLI
CURSOR_CLI_PATH=cursor-agent
TASK_TIMEOUT=600
CURSOR_AGENT_MAX_OUTPUT_BYTES=65536

# Project roots
PROJECTS_ROOT=/workspace
PROJECT_SEARCH_ROOTS=/workspace,/projects
ALLOWED_PROJECT_ROOTS=/workspace,/projects
PROJECT_FILE_SIGNATURES=package.json,pyproject.toml,Cargo.toml,go.mod,pom.xml,build.gradle,Gemfile,composer.json

# Security / sandbox
ALLOWED_COMMAND_PREFIXES=git,ls,cat,head,tail,find,grep,python,python3,pip,node,npm,yarn,pnpm,cargo,go,make
FORBIDDEN_PATH_SEGMENTS=.git,.env,node_modules,__pycache__,.ssh,.aws
UPLOAD_STORAGE_PATH=/data/uploads
MAX_UPLOAD_BYTES=10485760

# Confirmation workflow
CONFIRMATION_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Application
APP_ENV=production

# Legacy aliases (optional, still supported)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS=
# WORKSPACE_BASE=
# PROJECT_DISCOVERY_ROOTS=
# CURSOR_AGENT_BIN=
# CURSOR_AGENT_TIMEOUT_SECONDS=
